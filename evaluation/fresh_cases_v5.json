        "column_filters": [{"field": "FactSales[Channel]", "operator": "eq", "value": "In-Store"}],
        "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimCustomer'[AgeBand],\n    TREATAS({\"In-Store\"}, 'FactSales'[Channel]),\n    \"Net Sales\", [Net Sales]\n)"
    },
    {
      "id": "FRESH5-004", "category": "answerable", "probe": "single_value_filter",
      "question": "Show total discounts by brand for Mall stores.",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Total Discounts"}],
