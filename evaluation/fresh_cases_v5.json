      "requirement": {
        "metrics": [{"kind": "measure", "name": "Net Sales"}],
        "group_by": ["DimProduct[Subcategory]"],
        "column_filters": [
          {"field": "DimProduct[Category]", "operator": "eq", "value": "Beverages"},
          {"field": "DimDate[Quarter]", "operator": "eq", "value": "Q1"}
