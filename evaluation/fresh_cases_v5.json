{
  "version": 5,
  "description": "Fifth fresh held-out set, authored 2026-11-16 AFTER semantic rule 3 / pipeline v5 was committed (fd22675), and committed before any reference capture or model generation on it. Used for a same-case A/B of pipeline v4 vs v5. Probes: single-value filters combined with grouping by a different column (rule 3 target), ne filters on a grouped column that rule 3 must allow (over-correction probes), untargeted general cases, and unsupported cases.",
  "cases": [
    {
      "id": "FRESH5-001", "category": "answerable", "probe": "single_value_filter",
      "question": "Show units sold by store region for the Wallet payment method.",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Units Sold"}],
        "group_by": ["DimStore[Region]"],
        "column_filters": [{"field": "FactSales[PaymentMethod]", "operator": "eq", "value": "Wallet"}],
        "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimStore'[Region],\n    TREATAS({\"Wallet\"}, 'FactSales'[PaymentMethod]),\n    \"Units Sold\", [Units Sold]\n)"
    },
    {
      "id": "FRESH5-002", "category": "answerable", "probe": "single_value_filter",
      "question": "What was gross profit by product category in the Western region?",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Gross Profit"}],
        "group_by": ["DimProduct[Category]"],
        "column_filters": [{"field": "DimStore[Region]", "operator": "eq", "value": "Western"}],
        "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimProduct'[Category],\n    TREATAS({\"Western\"}, 'DimStore'[Region]),\n    \"Gross Profit\", [Gross Profit]\n)"
    },
    {
      "id": "FRESH5-003", "category": "answerable", "probe": "single_value_filter",
      "question": "Show net sales by customer age band for in-store sales.",
