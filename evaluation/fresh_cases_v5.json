      "reference_dax": "EVALUATE\nCALCULATETABLE(\n    SUMMARIZECOLUMNS(\n        'FactSales'[Channel],\n        \"Net Sales\", [Net Sales]\n    ),\n    'FactSales'[Channel] <> \"Delivery\"\n)"
    },
    {
      "id": "FRESH5-010", "category": "answerable", "probe": "ne_filter_allowed",
