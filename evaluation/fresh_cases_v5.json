      "id": "FRESH5-005", "category": "answerable", "probe": "single_value_filter",
      "question": "What were gross sales by day of the week for the Corporate segment?",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Gross Sales"}],
        "group_by": ["DimDate[DayName]"],
        "column_filters": [{"field": "DimCustomer[CustomerSegment]", "operator": "eq", "value": "Corporate"}],
        "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimDate'[DayName],\n    TREATAS({\"Corporate\"}, 'DimCustomer'[CustomerSegment]),\n    \"Gross Sales\", [Gross Sales]\n)"
    },
    {
