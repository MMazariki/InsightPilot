      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimProduct'[Subcategory],\n    TREATAS({\"Beverages\"}, 'DimProduct'[Category]),\n    TREATAS({\"Q1\"}, 'DimDate'[Quarter]),\n    \"Net Sales\", [Net Sales]\n)"
    },
