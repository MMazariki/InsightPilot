      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimProduct'[Brand],\n    TREATAS({\"Mall\"}, 'DimStore'[StoreType]),\n    \"Total Discounts\", [Total Discounts]\n)"
