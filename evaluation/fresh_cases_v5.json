      "reference_dax": "EVALUATE\nCALCULATETABLE(\n    SUMMARIZECOLUMNS(\n        'FactSales'[PaymentMethod],\n        'FactSales'[Channel],\n        \"Units Sold\", [Units Sold]\n    ),\n    'FactSales'[Channel] <> \"In-Store\"\n)"
    },
    {
      "id": "FRESH5-011", "category": "answerable", "probe": "general",
      "question": "Show the five store cities with the highest net sales.",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Net Sales"}],
        "group_by": ["DimStore[City]"],
        "column_filters": [], "metric_filters": [],
        "order_by": [{"metric": {"kind": "measure", "name": "Net Sales"}, "direction": "desc"}],
        "limit": 5
      },
      "reference_dax": "EVALUATE\nTOPN(\n    5,\n    SUMMARIZECOLUMNS(\n        'DimStore'[City],\n        \"Net Sales\", [Net Sales]\n    ),\n    [Net Sales], DESC,\n    'DimStore'[City], ASC\n)\nORDER BY [Net Sales] DESC, 'DimStore'[City] ASC"
    },
    {
      "id": "FRESH5-012", "category": "answerable", "probe": "general",
      "question": "What is the average number of units per distinct order for each sales channel?",
      "requirement": {
        "metrics": [{
          "kind": "divide",
          "numerator": {"kind": "measure", "name": "Units Sold"},
          "denominator": {"kind": "distinct_count", "table": "FactSales", "column": "OrderID"}
        }],
        "group_by": ["FactSales[Channel]"],
        "column_filters": [], "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'FactSales'[Channel],\n    \"Units per Order\", DIVIDE([Units Sold], DISTINCTCOUNT('FactSales'[OrderID]))\n)"
    },
