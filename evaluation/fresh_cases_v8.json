{
  "version": 8,
  "description": "Eighth fresh held-out set, authored 2026-11-16 AFTER pipeline v8 (decline path in the column-as-measure hint) was committed (0179ad4), and committed before any reference capture or model generation on it. Used for a same-case A/B of pipeline v7 vs v8. Answerable questions include existing measures with KPI-like names (over-refusal probes) and column-named breakdowns; unsupported questions include metrics that exist only as raw columns the plan schema cannot aggregate (substitution probes). The fresh_v7 marketing-spend question that motivated v8 is excluded.",
  "cases": [
    {
      "id": "FRESH8-001", "category": "answerable", "probe": "kpi_named_measure",
      "question": "Show the sales target by store region.",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Sales Target"}],
        "group_by": ["DimStore[Region]"],
        "column_filters": [], "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimStore'[Region],\n    \"Sales Target\", [Sales Target]\n)"
    },
    {
      "id": "FRESH8-002", "category": "answerable", "probe": "kpi_named_measure",
      "question": "What is the sales variance for each store region?",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Sales Variance"}],
        "group_by": ["DimStore[Region]"],
        "column_filters": [], "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimStore'[Region],\n    \"Sales Variance\", [Sales Variance]\n)"
    },
    {
      "id": "FRESH8-003", "category": "answerable", "probe": "column_named",
      "question": "Show net sales by payment method for the Click & Collect channel.",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Net Sales"}],
        "group_by": ["FactSales[PaymentMethod]"],
        "column_filters": [{"field": "FactSales[Channel]", "operator": "eq", "value": "Click & Collect"}],
        "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'FactSales'[PaymentMethod],\n    TREATAS({\"Click & Collect\"}, 'FactSales'[Channel]),\n    \"Net Sales\", [Net Sales]\n)"
    },
    {
      "id": "FRESH8-004", "category": "answerable", "probe": "column_named",
      "question": "How many units were sold for each subcategory in the Accessories category?",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Units Sold"}],
        "group_by": ["DimProduct[Subcategory]"],
        "column_filters": [{"field": "DimProduct[Category]", "operator": "eq", "value": "Accessories"}],
        "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimProduct'[Subcategory],\n    TREATAS({\"Accessories\"}, 'DimProduct'[Category]),\n    \"Units Sold\", [Units Sold]\n)"
    },
    {
      "id": "FRESH8-005", "category": "answerable", "probe": "column_named",
      "question": "Show gross profit by customer gender.",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Gross Profit"}],
        "group_by": ["DimCustomer[Gender]"],
        "column_filters": [], "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimCustomer'[Gender],\n    \"Gross Profit\", [Gross Profit]\n)"
    },
    {
      "id": "FRESH8-006", "category": "answerable", "probe": "general",
      "question": "Which three store cities had the lowest net sales?",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Net Sales"}],
        "group_by": ["DimStore[City]"],
        "column_filters": [], "metric_filters": [],
        "order_by": [{"metric": {"kind": "measure", "name": "Net Sales"}, "direction": "asc"}],
        "limit": 3
      },
      "reference_dax": "EVALUATE\nTOPN(\n    3,\n    SUMMARIZECOLUMNS(\n        'DimStore'[City],\n        \"Net Sales\", [Net Sales]\n    ),\n    [Net Sales], ASC,\n    'DimStore'[City], ASC\n)\nORDER BY [Net Sales] ASC, 'DimStore'[City] ASC"
    },
    {
      "id": "FRESH8-007", "category": "answerable", "probe": "column_named",
      "question": "How many distinct orders used each payment method in the Western region?",
