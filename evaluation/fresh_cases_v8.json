        "metrics": [{"kind": "distinct_count", "table": "FactSales", "column": "OrderID"}],
        "group_by": ["FactSales[PaymentMethod]"],
        "column_filters": [{"field": "DimStore[Region]", "operator": "eq", "value": "Western"}],
        "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'FactSales'[PaymentMethod],\n    TREATAS({\"Western\"}, 'DimStore'[Region]),\n    \"Distinct Orders\", DISTINCTCOUNT('FactSales'[OrderID])\n)"
    },
