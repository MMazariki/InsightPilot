    {
      "id": "FRESH8-010", "category": "answerable", "probe": "general",
      "question": "What is gross profit per distinct customer in each store region?",
      "requirement": {
        "metrics": [{
          "kind": "divide",
          "numerator": {"kind": "measure", "name": "Gross Profit"},
          "denominator": {"kind": "distinct_count", "table": "FactSales", "column": "CustomerKey"}
        }],
        "group_by": ["DimStore[Region]"],
        "column_filters": [], "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimStore'[Region],\n    \"Gross Profit per Customer\", DIVIDE([Gross Profit], DISTINCTCOUNT('FactSales'[CustomerKey]))\n)"
    },
