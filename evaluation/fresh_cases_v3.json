{
  "version": 3,
  "description": "Third fresh held-out set, authored 2026-11-16 AFTER prompt v3 and the multi-alias comparator were committed (70dd29b), and committed before any reference capture or model generation on it. Used for a same-case A/B of prompt v2 vs prompt v3 (both with the request guard). Contains probes for each v3 convention (percentage scale, monthly grouping incl. a MonthName over-correction probe, fact-key distinct counts, no unrequested groupings), untargeted general cases, and unsupported cases to check declines do not regress. Thresholds were chosen from observed measure values so that a wrong percentage scale returns a different row set.",
  "cases": [
    {
      "id": "FRESH3-001",
      "category": "answerable",
      "probe": "percentage_scale",
      "question": "Which store types have a gross margin percentage above 45.8%?",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Gross Margin %"}],
        "group_by": ["DimStore[StoreType]"],
        "column_filters": [],
        "metric_filters": [{"metric": {"kind": "measure", "name": "Gross Margin %"}, "operator": "gt", "value": 0.458}],
        "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nFILTER(\n    SUMMARIZECOLUMNS(\n        'DimStore'[StoreType],\n        \"Gross Margin %\", [Gross Margin %]\n    ),\n    [Gross Margin %] > 0.458\n)"
    },
    {
      "id": "FRESH3-002",
      "category": "answerable",
      "probe": "percentage_scale",
      "question": "List the customer segments whose margin on gross sales percentage is below 44.2 percent.",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Margin on Gross Sales %"}],
        "group_by": ["DimCustomer[CustomerSegment]"],
        "column_filters": [],
        "metric_filters": [{"metric": {"kind": "measure", "name": "Margin on Gross Sales %"}, "operator": "lt", "value": 0.442}],
        "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nFILTER(\n    SUMMARIZECOLUMNS(\n        'DimCustomer'[CustomerSegment],\n        \"Margin on Gross Sales %\", [Margin on Gross Sales %]\n    ),\n    [Margin on Gross Sales %] < 0.442\n)"
    },
    {
      "id": "FRESH3-003",
      "category": "answerable",
      "probe": "percentage_scale",
      "question": "Which store regions have a target achievement percentage below 2.55%?",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Target Achievement %"}],
        "group_by": ["DimStore[Region]"],
        "column_filters": [],
        "metric_filters": [{"metric": {"kind": "measure", "name": "Target Achievement %"}, "operator": "lt", "value": 0.0255}],
        "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nFILTER(\n    SUMMARIZECOLUMNS(\n        'DimStore'[Region],\n        \"Target Achievement %\", [Target Achievement %]\n    ),\n    [Target Achievement %] < 0.0255\n)"
    },
    {
      "id": "FRESH3-004",
      "category": "answerable",
      "probe": "monthly_grouping",
      "question": "What were the gross profit figures month by month?",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Gross Profit"}],
        "group_by": ["DimDate[YearMonth]"],
        "column_filters": [], "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimDate'[YearMonth],\n    \"Gross Profit\", [Gross Profit]\n)"
    },
    {
      "id": "FRESH3-005",
      "category": "answerable",
      "probe": "monthly_grouping",
      "question": "Show net sales per month for the Delivery channel.",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Net Sales"}],
        "group_by": ["DimDate[YearMonth]"],
        "column_filters": [{"field": "FactSales[Channel]", "operator": "eq", "value": "Delivery"}],
        "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimDate'[YearMonth],\n    TREATAS({\"Delivery\"}, 'FactSales'[Channel]),\n    \"Net Sales\", [Net Sales]\n)"
    },
    {
      "id": "FRESH3-006",
      "category": "answerable",
      "probe": "monthly_grouping_exception",
      "question": "Show units sold by month name.",
      "note": "Over-correction probe: the user explicitly asks for month names.",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Units Sold"}],
        "group_by": ["DimDate[MonthName]"],
        "column_filters": [], "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimDate'[MonthName],\n    \"Units Sold\", [Units Sold]\n)"
    },
    {
      "id": "FRESH3-007",
      "category": "answerable",
      "probe": "fact_key_distinct_count",
      "question": "How many distinct customers bought products in each product category?",
      "requirement": {
        "metrics": [{"kind": "distinct_count", "table": "FactSales", "column": "CustomerKey"}],
        "group_by": ["DimProduct[Category]"],
        "column_filters": [], "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimProduct'[Category],\n    \"Distinct Customers\", DISTINCTCOUNT('FactSales'[CustomerKey])\n)"
    },
    {
      "id": "FRESH3-008",
      "category": "answerable",
      "probe": "fact_key_distinct_count",
      "question": "How many different stores sold each brand?",
      "note": "Every brand sold in all 20 stores, so a dimension-key count returns the same values; only requirement coverage detects the wrong column.",
      "requirement": {
        "metrics": [{"kind": "distinct_count", "table": "FactSales", "column": "StoreKey"}],
        "group_by": ["DimProduct[Brand]"],
        "column_filters": [], "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimProduct'[Brand],\n    \"Distinct Stores\", DISTINCTCOUNT('FactSales'[StoreKey])\n)"
    },
    {
      "id": "FRESH3-009",
      "category": "answerable",
      "probe": "fact_key_distinct_count",
      "question": "How many distinct orders were placed by each customer age band?",
      "requirement": {
        "metrics": [{"kind": "distinct_count", "table": "FactSales", "column": "OrderID"}],
        "group_by": ["DimCustomer[AgeBand]"],
        "column_filters": [], "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimCustomer'[AgeBand],\n    \"Distinct Orders\", DISTINCTCOUNT('FactSales'[OrderID])\n)"
    },
    {
      "id": "FRESH3-010",
      "category": "answerable",
      "probe": "no_extra_grouping",
      "question": "Show gross sales by store region for Express stores.",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Gross Sales"}],
        "group_by": ["DimStore[Region]"],
        "column_filters": [{"field": "DimStore[StoreType]", "operator": "eq", "value": "Express"}],
        "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimStore'[Region],\n    TREATAS({\"Express\"}, 'DimStore'[StoreType]),\n    \"Gross Sales\", [Gross Sales]\n)"
    },
    {
      "id": "FRESH3-011",
      "category": "answerable",
      "probe": "no_extra_grouping",
      "question": "What were total net sales by store city for Wallet payments?",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Net Sales"}],
        "group_by": ["DimStore[City]"],
        "column_filters": [{"field": "FactSales[PaymentMethod]", "operator": "eq", "value": "Wallet"}],
        "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimStore'[City],\n    TREATAS({\"Wallet\"}, 'FactSales'[PaymentMethod]),\n    \"Net Sales\", [Net Sales]\n)"
    },
    {
      "id": "FRESH3-012",
      "category": "answerable",
      "probe": "general",
      "question": "Show the bottom three brands by units sold.",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Units Sold"}],
        "group_by": ["DimProduct[Brand]"],
        "column_filters": [], "metric_filters": [],
        "order_by": [{"metric": {"kind": "measure", "name": "Units Sold"}, "direction": "asc"}],
        "limit": 3
      },
      "reference_dax": "EVALUATE\nTOPN(\n    3,\n    SUMMARIZECOLUMNS(\n        'DimProduct'[Brand],\n        \"Units Sold\", [Units Sold]\n    ),\n    [Units Sold], ASC,\n    'DimProduct'[Brand], ASC\n)\nORDER BY [Units Sold] ASC, 'DimProduct'[Brand] ASC"
    },
    {
      "id": "FRESH3-013",
      "category": "answerable",
      "probe": "general",
      "question": "What is the average gross profit per distinct customer?",
      "requirement": {
        "metrics": [{
          "kind": "divide",
          "numerator": {"kind": "measure", "name": "Gross Profit"},
          "denominator": {"kind": "distinct_count", "table": "FactSales", "column": "CustomerKey"}
        }],
        "group_by": [],
        "column_filters": [], "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nROW(\n    \"Gross Profit per Customer\",\n    DIVIDE([Gross Profit], DISTINCTCOUNT('FactSales'[CustomerKey]))\n)"
    },
    {
      "id": "FRESH3-014",
      "category": "answerable",
      "probe": "general",
      "question": "Show total discounts by customer gender, highest first.",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Total Discounts"}],
        "group_by": ["DimCustomer[Gender]"],
        "column_filters": [], "metric_filters": [],
        "order_by": [{"metric": {"kind": "measure", "name": "Total Discounts"}, "direction": "desc"}],
        "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimCustomer'[Gender],\n    \"Total Discounts\", [Total Discounts]\n)\nORDER BY [Total Discounts] DESC"
    },
