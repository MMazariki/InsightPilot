{
  "version": 9,
  "description": "Ninth fresh held-out set, authored 2026-11-16 AFTER pipeline v9 (answerability gate) was committed (5db2a26), and committed before any reference capture or model generation on it. Used for a same-case A/B of pipeline v7 (app default) vs v9. Answerable questions include benign words outside the model vocabulary (biggest, weakest, rundown, separate, brought in) that fire the trigger and test verifier over-refusal; unsupported questions are the kind that yield schema-valid plans directly (forecasts, what-ifs, missing data, vague requests).",
  "cases": [
    {
      "id": "FRESH9-001", "category": "answerable", "probe": "benign_unknown_word",
      "question": "Which five brands had the biggest net sales?",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Net Sales"}],
        "group_by": ["DimProduct[Brand]"],
        "column_filters": [], "metric_filters": [],
        "order_by": [{"metric": {"kind": "measure", "name": "Net Sales"}, "direction": "desc"}],
        "limit": 5
      },
      "reference_dax": "EVALUATE\nTOPN(\n    5,\n    SUMMARIZECOLUMNS(\n        'DimProduct'[Brand],\n        \"Net Sales\", [Net Sales]\n    ),\n    [Net Sales], DESC,\n    'DimProduct'[Brand], ASC\n)\nORDER BY [Net Sales] DESC, 'DimProduct'[Brand] ASC"
    },
    {
      "id": "FRESH9-002", "category": "answerable", "probe": "benign_unknown_word",
      "question": "Which store region was the weakest by gross profit?",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Gross Profit"}],
        "group_by": ["DimStore[Region]"],
        "column_filters": [], "metric_filters": [],
        "order_by": [{"metric": {"kind": "measure", "name": "Gross Profit"}, "direction": "asc"}],
        "limit": 1
      },
      "reference_dax": "EVALUATE\nTOPN(\n    1,\n    SUMMARIZECOLUMNS(\n        'DimStore'[Region],\n        \"Gross Profit\", [Gross Profit]\n    ),\n    [Gross Profit], ASC,\n    'DimStore'[Region], ASC\n)\nORDER BY [Gross Profit] ASC, 'DimStore'[Region] ASC"
    },
    {
      "id": "FRESH9-003", "category": "answerable", "probe": "general",
      "question": "Show me a split of units sold across customer segments.",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Units Sold"}],
        "group_by": ["DimCustomer[CustomerSegment]"],
        "column_filters": [], "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimCustomer'[CustomerSegment],\n    \"Units Sold\", [Units Sold]\n)"
    },
    {
      "id": "FRESH9-004", "category": "answerable", "probe": "benign_unknown_word",
      "question": "Give a rundown of net sales by payment method.",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Net Sales"}],
        "group_by": ["FactSales[PaymentMethod]"],
        "column_filters": [], "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'FactSales'[PaymentMethod],\n    \"Net Sales\", [Net Sales]\n)"
    },
    {
      "id": "FRESH9-005", "category": "answerable", "probe": "general",
      "question": "What are the gross sales numbers for each store type?",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Gross Sales"}],
        "group_by": ["DimStore[StoreType]"],
        "column_filters": [], "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimStore'[StoreType],\n    \"Gross Sales\", [Gross Sales]\n)"
    },
    {
      "id": "FRESH9-006", "category": "answerable", "probe": "general",
      "question": "Show net sales by channel for female shoppers.",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Net Sales"}],
        "group_by": ["FactSales[Channel]"],
        "column_filters": [{"field": "DimCustomer[Gender]", "operator": "eq", "value": "Female"}],
        "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'FactSales'[Channel],\n    TREATAS({\"Female\"}, 'DimCustomer'[Gender]),\n    \"Net Sales\", [Net Sales]\n)"
    },
    {
      "id": "FRESH9-007", "category": "answerable", "probe": "benign_unknown_word",
      "question": "How many separate orders came through the Delivery channel in each store region?",
      "requirement": {
        "metrics": [{"kind": "distinct_count", "table": "FactSales", "column": "OrderID"}],
        "group_by": ["DimStore[Region]"],
        "column_filters": [{"field": "FactSales[Channel]", "operator": "eq", "value": "Delivery"}],
        "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimStore'[Region],\n    TREATAS({\"Delivery\"}, 'FactSales'[Channel]),\n    \"Distinct Orders\", DISTINCTCOUNT('FactSales'[OrderID])\n)"
    },
    {
      "id": "FRESH9-008", "category": "answerable", "probe": "general",
      "question": "Show gross margin percentage per product subcategory, best to worst.",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Gross Margin %"}],
        "group_by": ["DimProduct[Subcategory]"],
        "column_filters": [], "metric_filters": [],
        "order_by": [{"metric": {"kind": "measure", "name": "Gross Margin %"}, "direction": "desc"}],
        "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimProduct'[Subcategory],\n    \"Gross Margin %\", [Gross Margin %]\n)\nORDER BY [Gross Margin %] DESC"
    },
    {
      "id": "FRESH9-009", "category": "answerable", "probe": "general",
      "question": "Show units sold by month for Corporate customers.",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Units Sold"}],
        "group_by": ["DimDate[YearMonth]"],
        "column_filters": [{"field": "DimCustomer[CustomerSegment]", "operator": "eq", "value": "Corporate"}],
        "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimDate'[YearMonth],\n    TREATAS({\"Corporate\"}, 'DimCustomer'[CustomerSegment]),\n    \"Units Sold\", [Units Sold]\n)"
    },
    {
      "id": "FRESH9-010", "category": "answerable", "probe": "general",
      "question": "What is net sales per unit sold for each brand?",
      "requirement": {
        "metrics": [{
          "kind": "divide",
          "numerator": {"kind": "measure", "name": "Net Sales"},
          "denominator": {"kind": "measure", "name": "Units Sold"}
        }],
        "group_by": ["DimProduct[Brand]"],
        "column_filters": [], "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimProduct'[Brand],\n    \"Net Sales per Unit\", DIVIDE([Net Sales], [Units Sold])\n)"
    },
    {
      "id": "FRESH9-011", "category": "answerable", "probe": "benign_unknown_word",
      "question": "Which store cities brought in more than SAR 60,000 in net sales?",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Net Sales"}],
        "group_by": ["DimStore[City]"],
        "column_filters": [],
        "metric_filters": [{"metric": {"kind": "measure", "name": "Net Sales"}, "operator": "gt", "value": 60000}],
        "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nFILTER(\n    SUMMARIZECOLUMNS(\n        'DimStore'[City],\n        \"Net Sales\", [Net Sales]\n    ),\n    [Net Sales] > 60000\n)"
    },
    {
      "id": "FRESH9-012", "category": "empty_result", "probe": "general",
      "question": "Which customer age bands had negative total discounts?",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Total Discounts"}],
        "group_by": ["DimCustomer[AgeBand]"],
        "column_filters": [],
        "metric_filters": [{"metric": {"kind": "measure", "name": "Total Discounts"}, "operator": "lt", "value": 0}],
        "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nFILTER(\n    SUMMARIZECOLUMNS(\n        'DimCustomer'[AgeBand],\n        \"Total Discounts\", [Total Discounts]\n    ),\n    [Total Discounts] < 0\n)"
    },
