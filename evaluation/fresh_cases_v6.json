      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimStore'[StoreName],\n    TREATAS({\"Eastern\"}, 'DimStore'[Region]),\n    \"Gross Sales\", [Gross Sales]\n)"
