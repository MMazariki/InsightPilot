{
  "version": 6,
  "description": "Sixth fresh held-out set, authored 2026-11-16 AFTER pipeline v6 (fix-it hints, v6 repair wording, alias normalisation) was committed (65843c1), and committed before any reference capture or model generation on it. Used for a same-case A/B of pipeline v5 vs v6. Answerable questions are phrased around column names (the pattern behind 3B's post-repair over-refusals); unsupported questions use plausible-sounding metrics the model does not contain, to check that hints do not push the planner into substitute answers.",
  "cases": [
    {
      "id": "FRESH6-001", "category": "answerable", "probe": "column_named",
      "question": "Show net sales by payment method and customer gender.",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Net Sales"}],
        "group_by": ["FactSales[PaymentMethod]", "DimCustomer[Gender]"],
        "column_filters": [], "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'FactSales'[PaymentMethod],\n    'DimCustomer'[Gender],\n    \"Net Sales\", [Net Sales]\n)"
    },
    {
      "id": "FRESH6-002", "category": "answerable", "probe": "column_named",
      "question": "Which brand had the highest gross profit?",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Gross Profit"}],
        "group_by": ["DimProduct[Brand]"],
        "column_filters": [], "metric_filters": [],
        "order_by": [{"metric": {"kind": "measure", "name": "Gross Profit"}, "direction": "desc"}],
        "limit": 1
      },
      "reference_dax": "EVALUATE\nTOPN(\n    1,\n    SUMMARIZECOLUMNS(\n        'DimProduct'[Brand],\n        \"Gross Profit\", [Gross Profit]\n    ),\n    [Gross Profit], DESC,\n    'DimProduct'[Brand], ASC\n)\nORDER BY [Gross Profit] DESC, 'DimProduct'[Brand] ASC"
    },
    {
      "id": "FRESH6-003", "category": "answerable", "probe": "column_named",
      "question": "Show units sold by sales channel for the Food category.",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Units Sold"}],
        "group_by": ["FactSales[Channel]"],
        "column_filters": [{"field": "DimProduct[Category]", "operator": "eq", "value": "Food"}],
        "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'FactSales'[Channel],\n    TREATAS({\"Food\"}, 'DimProduct'[Category]),\n    \"Units Sold\", [Units Sold]\n)"
    },
    {
      "id": "FRESH6-004", "category": "answerable", "probe": "column_named",
      "question": "How many distinct customers bought each brand?",
      "requirement": {
        "metrics": [{"kind": "distinct_count", "table": "FactSales", "column": "CustomerKey"}],
        "group_by": ["DimProduct[Brand]"],
        "column_filters": [], "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimProduct'[Brand],\n    \"Distinct Customers\", DISTINCTCOUNT('FactSales'[CustomerKey])\n)"
