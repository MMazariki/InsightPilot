{
  "version": 4,
  "description": "Fourth fresh held-out set, authored 2026-11-16 AFTER the v4 pipeline (value catalog, semantic checks, prompt v4, one-shot repair) was committed (7ce6bf1), and committed before any reference capture or model generation on it. Used for a same-case A/B of prompt v3 vs the v4 pipeline. Probes: user wording that must be mapped to catalog values, distinct counts of sales entities in another table's context (plus one same-table case the semantic rule deliberately does not cover), untargeted general cases, and unsupported cases.",
  "cases": [
    {
      "id": "FRESH4-001", "category": "answerable", "probe": "value_mapping",
      "question": "Show net sales for the second quarter by sales channel.",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Net Sales"}],
        "group_by": ["FactSales[Channel]"],
        "column_filters": [{"field": "DimDate[Quarter]", "operator": "eq", "value": "Q2"}],
        "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'FactSales'[Channel],\n    TREATAS({\"Q2\"}, 'DimDate'[Quarter]),\n    \"Net Sales\", [Net Sales]\n)"
    },
    {
      "id": "FRESH4-002", "category": "answerable", "probe": "value_mapping",
      "question": "What were gross sales for click and collect orders by store region?",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Gross Sales"}],
        "group_by": ["DimStore[Region]"],
        "column_filters": [{"field": "FactSales[Channel]", "operator": "eq", "value": "Click & Collect"}],
        "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimStore'[Region],\n    TREATAS({\"Click & Collect\"}, 'FactSales'[Channel]),\n    \"Gross Sales\", [Gross Sales]\n)"
    },
    {
      "id": "FRESH4-003", "category": "answerable", "probe": "value_mapping",
      "question": "Show units sold by brand for card payments.",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Units Sold"}],
        "group_by": ["DimProduct[Brand]"],
        "column_filters": [{"field": "FactSales[PaymentMethod]", "operator": "eq", "value": "Card"}],
        "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimProduct'[Brand],\n    TREATAS({\"Card\"}, 'FactSales'[PaymentMethod]),\n    \"Units Sold\", [Units Sold]\n)"
    },
    {
      "id": "FRESH4-004", "category": "answerable", "probe": "value_mapping",
      "question": "Show net sales by product subcategory within the snacks category.",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Net Sales"}],
        "group_by": ["DimProduct[Subcategory]"],
        "column_filters": [{"field": "DimProduct[Category]", "operator": "eq", "value": "Snacks"}],
        "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimProduct'[Subcategory],\n    TREATAS({\"Snacks\"}, 'DimProduct'[Category]),\n    \"Net Sales\", [Net Sales]\n)"
    },
    {
      "id": "FRESH4-005", "category": "answerable", "probe": "value_mapping",
      "question": "How much gross profit came from tourist customers in each store city?",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Gross Profit"}],
        "group_by": ["DimStore[City]"],
        "column_filters": [{"field": "DimCustomer[CustomerSegment]", "operator": "eq", "value": "Tourist"}],
        "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimStore'[City],\n    TREATAS({\"Tourist\"}, 'DimCustomer'[CustomerSegment]),\n    \"Gross Profit\", [Gross Profit]\n)"
    },
    {
      "id": "FRESH4-006", "category": "answerable", "probe": "value_mapping",
      "question": "Show total discounts on Fridays by customer segment.",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Total Discounts"}],
        "group_by": ["DimCustomer[CustomerSegment]"],
        "column_filters": [{"field": "DimDate[DayName]", "operator": "eq", "value": "Friday"}],
        "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimCustomer'[CustomerSegment],\n    TREATAS({\"Friday\"}, 'DimDate'[DayName]),\n    \"Total Discounts\", [Total Discounts]\n)"
    },
    {
      "id": "FRESH4-007", "category": "answerable", "probe": "fact_key_in_context",
      "question": "How many distinct customers made purchases with each payment method?",
      "requirement": {
        "metrics": [{"kind": "distinct_count", "table": "FactSales", "column": "CustomerKey"}],
        "group_by": ["FactSales[PaymentMethod]"],
        "column_filters": [], "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'FactSales'[PaymentMethod],\n    \"Distinct Customers\", DISTINCTCOUNT('FactSales'[CustomerKey])\n)"
    },
    {
      "id": "FRESH4-008", "category": "answerable", "probe": "fact_key_in_context",
      "question": "How many different products were sold in each store region?",
      "requirement": {
        "metrics": [{"kind": "distinct_count", "table": "FactSales", "column": "ProductKey"}],
        "group_by": ["DimStore[Region]"],
        "column_filters": [], "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimStore'[Region],\n    \"Distinct Products\", DISTINCTCOUNT('FactSales'[ProductKey])\n)"
    },
    {
      "id": "FRESH4-009", "category": "answerable", "probe": "fact_key_in_context",
      "question": "How many distinct stores had sales in each month?",
      "requirement": {
        "metrics": [{"kind": "distinct_count", "table": "FactSales", "column": "StoreKey"}],
        "group_by": ["DimDate[YearMonth]"],
        "column_filters": [], "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimDate'[YearMonth],\n    \"Distinct Stores\", DISTINCTCOUNT('FactSales'[StoreKey])\n)"
    },
    {
      "id": "FRESH4-010", "category": "answerable", "probe": "fact_key_same_table_gap",
      "question": "What is the average net sales per distinct buying customer for each customer segment?",
      "note": "Grouping is on the same dimension table, which the semantic rule deliberately allows; a DimCustomer count would include customers without purchases.",
      "requirement": {
        "metrics": [{
          "kind": "divide",
          "numerator": {"kind": "measure", "name": "Net Sales"},
          "denominator": {"kind": "distinct_count", "table": "FactSales", "column": "CustomerKey"}
        }],
        "group_by": ["DimCustomer[CustomerSegment]"],
        "column_filters": [], "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimCustomer'[CustomerSegment],\n    \"Net Sales per Buying Customer\", DIVIDE([Net Sales], DISTINCTCOUNT('FactSales'[CustomerKey]))\n)"
    },
    {
      "id": "FRESH4-011", "category": "answerable", "probe": "general",
      "question": "Show the top four store cities by gross profit.",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Gross Profit"}],
        "group_by": ["DimStore[City]"],
        "column_filters": [], "metric_filters": [],
        "order_by": [{"metric": {"kind": "measure", "name": "Gross Profit"}, "direction": "desc"}],
        "limit": 4
      },
      "reference_dax": "EVALUATE\nTOPN(\n    4,\n    SUMMARIZECOLUMNS(\n        'DimStore'[City],\n        \"Gross Profit\", [Gross Profit]\n    ),\n    [Gross Profit], DESC,\n    'DimStore'[City], ASC\n)\nORDER BY [Gross Profit] DESC, 'DimStore'[City] ASC"
    },
    {
      "id": "FRESH4-012", "category": "answerable", "probe": "general",
      "question": "What is the gross margin percentage for each sales channel?",
      "requirement": {
        "metrics": [{"kind": "measure", "name": "Gross Margin %"}],
        "group_by": ["FactSales[Channel]"],
        "column_filters": [], "metric_filters": [], "order_by": [], "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'FactSales'[Channel],\n    \"Gross Margin %\", [Gross Margin %]\n)"
    },
    {
      "id": "FRESH4-013", "category": "answerable", "probe": "general",
      "question": "Show net sales by quarter, lowest first.",
      "requirement": {
