      "reference_dax": "EVALUATE\nFILTER(\n    SUMMARIZECOLUMNS(\n        'DimCustomer'[AgeBand],\n        \"Units Sold\", [Units Sold]\n    ),\n    [Units Sold] > 5000\n)"
