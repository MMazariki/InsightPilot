        "group_by": ["DimCustomer[AgeBand]"],
        "column_filters": [],
        "metric_filters": [{"metric": {"kind": "measure", "name": "Units Sold"}, "operator": "gt", "value": 5000}],
        "order_by": [], "limit": null
