        "group_by": ["DimDate[Quarter]"],
        "column_filters": [], "metric_filters": [],
        "order_by": [{"metric": {"kind": "measure", "name": "Net Sales"}, "direction": "asc"}],
        "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimDate'[Quarter],\n    \"Net Sales\", [Net Sales]\n)\nORDER BY [Net Sales] ASC"
    },
    {
      "id": "FRESH4-014", "category": "answerable", "probe": "general",
      "question": "Which customer age bands sold more than 5,000 units?",
