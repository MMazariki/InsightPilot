    },
    {
      "id": "FRESH11-008",
      "category": "answerable",
      "probe": "entity_first",
      "question": "Compare the regions on units sold per order.",
      "requirement": {
        "metrics": [
          {
            "kind": "divide",
            "numerator": {
              "kind": "measure",
              "name": "Units Sold"
            },
            "denominator": {
              "kind": "distinct_count",
              "table": "FactSales",
              "column": "OrderID"
            }
          }
        ],
        "group_by": [
          "DimStore[Region]"
        ],
        "column_filters": [],
        "metric_filters": [],
        "order_by": [],
        "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimStore'[Region],\n    \"M0\", DIVIDE([Units Sold], DISTINCTCOUNT('FactSales'[OrderID]))\n)"
    },
    {
      "id": "FRESH11-009",
      "category": "answerable",
      "probe": "entity_first",
      "question": "Which subcategories sold more than 2,000 units?",
      "requirement": {
        "metrics": [
          {
            "kind": "measure",
            "name": "Units Sold"
          }
        ],
        "group_by": [
          "DimProduct[Subcategory]"
        ],
        "column_filters": [],
        "metric_filters": [
          {
            "metric": {
              "kind": "measure",
              "name": "Units Sold"
            },
            "operator": "gt",
            "value": 2000
          }
        ],
        "order_by": [],
        "limit": null
      },
      "reference_dax": "EVALUATE\nFILTER(\n    SUMMARIZECOLUMNS(\n        'DimProduct'[Subcategory],\n        \"M0\", [Units Sold]\n    ),\n    [M0] > 2000\n)"
    },
