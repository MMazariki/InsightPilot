{
  "version": 11,
  "description": "Eleventh fresh held-out set, authored 2026-11-16 AFTER pipeline v12 (stricter metric-word list in the no-metric gate trigger) was committed (d467725), and committed before any reference capture or model generation on it. Used for a same-case A/B of pipeline v11 (app) vs v12. Targeted probes: unsupported questions are vague requests that mention a grouping entity but no metric; answerable questions lead with a grouping entity and name their metric, plus two 'no_quantity_word' probes (distinct counts of grouping entities without 'how many') on which the v12 trigger fires and the verifier must pass a faithful plan. Reference DAX is compiled from each requirement spec by the deterministic compiler.",
  "cases": [
    {
      "id": "FRESH11-001",
      "category": "answerable",
      "probe": "entity_first",
      "question": "Rank the store regions by gross profit.",
      "requirement": {
        "metrics": [
          {
            "kind": "measure",
            "name": "Gross Profit"
          }
        ],
        "group_by": [
          "DimStore[Region]"
        ],
        "column_filters": [],
        "metric_filters": [],
        "order_by": [
          {
            "metric": {
              "kind": "measure",
              "name": "Gross Profit"
            },
            "direction": "desc"
          }
        ],
        "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimStore'[Region],\n    \"M0\", [Gross Profit]\n)\nORDER BY [M0] DESC"
    },
    {
      "id": "FRESH11-002",
      "category": "answerable",
      "probe": "entity_first",
      "question": "Compare net sales across store types.",
      "requirement": {
        "metrics": [
          {
            "kind": "measure",
            "name": "Net Sales"
          }
        ],
        "group_by": [
          "DimStore[StoreType]"
        ],
        "column_filters": [],
        "metric_filters": [],
        "order_by": [],
        "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimStore'[StoreType],\n    \"M0\", [Net Sales]\n)"
    },
    {
      "id": "FRESH11-003",
      "category": "answerable",
      "probe": "entity_first",
      "question": "Which channel sold the most units?",
      "requirement": {
        "metrics": [
          {
            "kind": "measure",
            "name": "Units Sold"
          }
        ],
        "group_by": [
          "FactSales[Channel]"
        ],
        "column_filters": [],
        "metric_filters": [],
        "order_by": [
          {
            "metric": {
              "kind": "measure",
              "name": "Units Sold"
            },
            "direction": "desc"
          }
        ],
        "limit": 1
      },
      "reference_dax": "EVALUATE\nTOPN(\n    1,\n    SUMMARIZECOLUMNS(\n        'FactSales'[Channel],\n        \"M0\", [Units Sold]\n    ),\n    [M0], DESC,\n    'FactSales'[Channel], ASC\n)\nORDER BY [M0] DESC, 'FactSales'[Channel] ASC"
    },
    {
      "id": "FRESH11-004",
      "category": "answerable",
      "probe": "entity_count",
      "question": "How many stores sold something in each region?",
      "requirement": {
        "metrics": [
          {
            "kind": "distinct_count",
            "table": "FactSales",
            "column": "StoreKey"
          }
        ],
        "group_by": [
          "DimStore[Region]"
        ],
        "column_filters": [],
        "metric_filters": [],
        "order_by": [],
        "limit": null
      },
      "reference_dax": "EVALUATE\nSUMMARIZECOLUMNS(\n    'DimStore'[Region],\n    \"M0\", DISTINCTCOUNT('FactSales'[StoreKey])\n)"
    },
    {
      "id": "FRESH11-005",
      "category": "answerable",
      "probe": "entity_first",
      "question": "Show gross sales for each brand in the Food category.",
      "requirement": {
        "metrics": [
          {
            "kind": "measure",
            "name": "Gross Sales"
          }
        ],
        "group_by": [
          "DimProduct[Brand]"
        ],
        "column_filters": [
          {
            "field": "DimProduct[Category]",
            "operator": "eq",
            "value": "Food"
          }
        ],
        "metric_filters": [],
        "order_by": [],
        "limit": null
      },
      "reference_dax": "EVALUATE\nCALCULATETABLE(\n    SUMMARIZECOLUMNS(\n        'DimProduct'[Brand],\n        \"M0\", [Gross Sales]\n    ),\n    'DimProduct'[Category] = \"Food\"\n)"
    },
    {
      "id": "FRESH11-006",
      "category": "answerable",
      "probe": "entity_count",
      "question": "How many distinct customers bought in each customer city?",
      "requirement": {
